# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TELEGRAM_BOT_TOKEN: Required for Telegram Bot functionality.
TELEGRAM_BOT_TOKEN=
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# APP_AUTH_TOKEN: Used for securing internal API communication (backend).
APP_AUTH_TOKEN="your-secure-token"
# VITE_APP_AUTH_TOKEN: Used for client-side API authentication.
VITE_APP_AUTH_TOKEN="your-secure-token"

# CLOUD_STORAGE_URL: Cloud object storage for media and files (e.g. AWS S3, Cloudinary)
CLOUD_STORAGE_URL="https://your-bucket-url.s3.amazonaws.com"

# AI_API_KEY: Alternative API key for using multiple AI providers (OpenAI / Vertex AI)
AI_API_KEY="sk-..."

# VECTOR_DB_URL: Pinecone / Weaviate URL for vector search memory
VECTOR_DB_URL="https://your-index.svc.pinecone.io"

# CLOUD_MONITORING_URL: Monitor your AI agents and traffic via cloud dashboards
CLOUD_MONITORING_URL="https://grafana.cloud.com/your-dashboard"

# VITE_SUPABASE_URL: Your Supabase Project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Your Supabase Anonymous Public Key
VITE_SUPABASE_ANON_KEY="your-anon-key"
